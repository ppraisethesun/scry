{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scry project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaultEnvironment", "environments", "applications"],
  "properties": {
    "defaultEnvironment": {
      "type": "string",
      "minLength": 1
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/environment" }
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/application" }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "description": "Literal token or ${env:VARIABLE_NAME} reference."
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts", "port"],
      "properties": {
        "hosts": { "$ref": "#/$defs/hosts" },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "token": { "$ref": "#/$defs/token" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "protocol": {
          "type": "string",
          "enum": ["scry", "xrpc"],
          "default": "scry"
        },
        "token": { "$ref": "#/$defs/token" },
        "requireConfirmation": {
          "type": "boolean",
          "default": false
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "default": 30000
        },
        "targets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/endpoint" }
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "paths"],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
